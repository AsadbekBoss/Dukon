PORT=3000
JWT_SECRET=iltimos_bu_qiymatni_ozgartiring_production_uchun

# Agar nginx/Apache kabi teskari proksi ortida ishlatilsa, quyidagini yoqing
# (aks holda login himoyasi barcha foydalanuvchilarni bitta IP deb hisoblaydi):
# TRUST_PROXY=1

# Faqat Vercel (yoki boshqa serverless muhit)ga joylashtirilganda kerak.
# Lokal kompyuterda ishlatish uchun bularni bo'sh qoldiring — bazaning
# lokal fayl nusxasi (data/dukon.db) avtomatik ishlatiladi.
# Turso'da baza yaratganingizdan so'ng shu ikkitasini shu yerga yozing:
# TURSO_DATABASE_URL=libsql://sizning-bazangiz.turso.io
# TURSO_AUTH_TOKEN=sizning_token_qiymatingiz
